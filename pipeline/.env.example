OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=z-ai/glm-5.2
DFS_LOGIN=your_dataforseo_login
DFS_PASS=your_dataforseo_password
# Standard SERP task delivery. Ranking tasks are submitted while the crawl is
# running. The audit waits only this short interactive window, then an idle
# worker continues collecting already-submitted tasks without re-running the audit.
DATAFORSEO_RANKING_POLL_SECONDS=5
DATAFORSEO_RANKING_FOREGROUND_WAIT_SECONDS=300
DATAFORSEO_RANKING_MAX_WAIT_SECONDS=900
DATAFORSEO_RANKING_RECONCILIATION_POLL_SECONDS=60
DATAFORSEO_RANKING_RESULT_WORKERS=12
# normal is the cost-preserving default. Set to high only when the account
# owner accepts DataForSEO's higher-priority task pricing for faster delivery.
DATAFORSEO_RANKING_PRIORITY=normal
SQLALCHEMY_DATABASE_URI=postgresql://seo_user:seo_password@db:5432/seo_agent
SECRET_KEY=replace_with_a_long_random_secret
LIBRECRAWL_URL=http://host.docker.internal:5080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_secure_admin_password
APP_ENV=development
LIBRECRAWL_REQUEST_TIMEOUT=180
LIBRECRAWL_POLL_INTERVAL=5
LIBRECRAWL_MAX_POLLS=120

# Validate HTTP(S) link targets which LibreCrawl discovered but did not fetch.
# Targets are deduplicated and checked concurrently after the crawl completes.
BROKEN_LINK_VALIDATION_ENABLED=true
BROKEN_LINK_VALIDATION_WORKERS=12
BROKEN_LINK_VALIDATION_PER_HOST_WORKERS=3
BROKEN_LINK_VALIDATION_TIMEOUT_SECONDS=10
# Keep false in production to prevent requests to private/local infrastructure
BROKEN_LINK_ALLOW_PRIVATE_HOSTS=false
